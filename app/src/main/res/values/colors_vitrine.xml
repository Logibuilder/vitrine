<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Interface premium. Deux palettes : claire et sombre.
        VitrineColors choisit la bonne selon le thème actif (automatique, clair ou sombre),
        ce qui permet de forcer un thème différent de celui du téléphone.
    -->

    <!-- Mode clair : ivoire chaud, encre, émeraude -->
    <color name="vitrine_light_background">#FFF5F3EE</color>     <!-- fond des écrans -->
    <color name="vitrine_light_surface">#FFFFFFFF</color>        <!-- cartes, menu -->
    <color name="vitrine_light_surface_muted">#FFEFECE5</color>  <!-- boutons secondaires, pistes -->
    <color name="vitrine_light_divider">#FFE5E1D8</color>        <!-- filets, LEDs éteintes -->
    <color name="vitrine_light_text_primary">#FF16181C</color>
    <color name="vitrine_light_text_muted">#FF7D7F85</color>
    <color name="vitrine_light_ink">#FF16181C</color>            <!-- élément sélectionné, action principale -->
    <color name="vitrine_light_on_ink">#FFFFFFFF</color>         <!-- texte et icônes sur l'encre -->
    <color name="vitrine_light_accent">#FF17805C</color>         <!-- émeraude : état actif -->
    <color name="vitrine_light_warning">#FFC98A1B</color>        <!-- or : attention, en pause -->
    <color name="vitrine_light_danger">#FFD13F44</color>         <!-- rouge : objectif dépassé, suppression -->

    <!-- Mode sombre : noir profond, ivoire, menthe -->
    <color name="vitrine_dark_background">#FF0B0C0E</color>
    <color name="vitrine_dark_surface">#FF15171A</color>
    <color name="vitrine_dark_surface_muted">#FF1F2226</color>
    <color name="vitrine_dark_divider">#FF2B2E33</color>
    <color name="vitrine_dark_text_primary">#FFF2EFE8</color>
    <color name="vitrine_dark_text_muted">#FF8C8F96</color>
    <color name="vitrine_dark_ink">#FFF2EFE8</color>
    <color name="vitrine_dark_on_ink">#FF0B0C0E</color>
    <color name="vitrine_dark_accent">#FF4FD1A1</color>
    <color name="vitrine_dark_warning">#FFE9B55A</color>
    <color name="vitrine_dark_danger">#FFFF6B70</color>

    <!-- Guirlande de LEDs (l'aperçu utilise les couleurs de l'interface) -->
    <color name="led_base_display">#FF0A0A0A</color>       <!-- support (plein écran) -->
    <color name="led_off_display">#FF1E1E1E</color>        <!-- LED éteinte (plein écran) -->
    <color name="led_color_1">#FF4CA34A</color>
    <color name="led_color_2">#FFE3A43A</color>
    <color name="led_color_3">#FFE86F5C</color>
    <color name="led_color_4">#FF4C8DF6</color>

    <!-- Couleurs de la lampe (lumière d'écran) -->
    <color name="light_white">#FFFFFFFF</color>
    <color name="light_warm">#FFFFD9A0</color>   <!-- blanc chaud, comme une ampoule -->
    <color name="light_cool">#FFD6ECFF</color>   <!-- blanc froid, comme la lumière du jour -->
    <color name="light_red">#FFFF2A1F</color>    <!-- préserve la vision de nuit -->

    <!-- Couleurs proposées pour le texte du message -->
    <color name="text_white">#FFFFFFFF</color>
    <color name="text_yellow">#FFFFFF00</color>
    <color name="text_green">#FF00FF00</color>
    <color name="text_red">#FFFF0000</color>

    <!-- Couleurs proposées pour le fond du message -->
    <color name="bg_black">#FF000000</color>
    <color name="bg_night_blue">#FF001133</color>
    <color name="bg_night_red">#FF220000</color>
    <color name="bg_white">#FFFFFFFF</color>
</resources>
